id: refusal/bad-knob
name: Invalid knob values named with their requirement
prose: |
  Each invalid --band or --threshold value is refused with the value and its requirement named on the line.
scope:
- src/**
- Cargo.toml
- Cargo.lock
- build
- materials/bordered.jpg
covers:
- R1
- R2
- R3
- R4
rows:
- run: ./brim detect materials/bordered.jpg --band 0.7
  expect:
    rc: 2
- run: ./brim detect materials/bordered.jpg --band 0
  expect:
    rc: 2
- run: ./brim detect materials/bordered.jpg --band abc
  expect:
    rc: 2
- run: ./brim detect materials/bordered.jpg --threshold 1.5
  expect:
    rc: 2
- run: ./brim detect materials/bordered.jpg --threshold -0.5
  expect:
    rc: 2
- run: ./brim detect materials/bordered.jpg --threshold xyz
  expect:
    rc: 2
