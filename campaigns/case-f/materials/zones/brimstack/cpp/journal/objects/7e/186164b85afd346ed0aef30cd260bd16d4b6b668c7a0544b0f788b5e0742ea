id: cli/errors
name: refuse trouble honestly
prose: "Every refusal is one brief English line on stderr and a nonzero exit: usage trouble (a bad knob value, an extra file argument, an unknown option) exits 2; picture trouble (a missing or unreadable file, not a picture at all, not JPEG, a side shorter than two pixels) exits 1. Each knob's invalid value is named together with its requirement.\n"
scope:
- brim
- material/**
covers:
- R1
rows:
- run: ./brim detect material/nosuch.jpg 2>&1
  expect:
    rc: 1
    out: "contains: cannot read material/nosuch.jpg: no such file"
- run: ./brim detect material/notjpeg.txt 2>&1
  expect:
    rc: 1
    out: "contains: not a picture at all"
- run: ./brim detect material/photo.png 2>&1
  expect:
    rc: 1
    out: "contains: not a JPEG picture"
- run: ./brim detect material/tiny.jpg 2>&1
  expect:
    rc: 1
    out: "contains: picture too small to search for a margin"
- run: ./brim detect --band 0.6 material/bordered.jpg 2>&1
  expect:
    rc: 2
    out: "contains: invalid --band 0.6: want a fraction of the side, greater than 0 and at most 0.5"
- run: ./brim detect --band 0 material/bordered.jpg 2>&1
  expect:
    rc: 2
    out: "contains: invalid --band 0: want a fraction of the side, greater than 0 and at most 0.5"
- run: ./brim detect --band abc material/bordered.jpg 2>&1
  expect:
    rc: 2
    out: "contains: invalid --band abc: want a fraction of the side, greater than 0 and at most 0.5"
- run: ./brim detect --threshold 1.5 material/bordered.jpg 2>&1
  expect:
    rc: 2
    out: "contains: invalid --threshold 1.5: want a fraction from 0 to 1"
- run: ./brim detect --threshold -0.1 material/bordered.jpg 2>&1
  expect:
    rc: 2
    out: "contains: invalid --threshold -0.1: want a fraction from 0 to 1"
- run: ./brim detect material/bordered.jpg material/clear.jpg 2>&1
  expect:
    rc: 2
    out: "contains: unrecognized arguments: material/clear.jpg"
- run: ./brim --bogus detect material/bordered.jpg 2>&1
  expect:
    rc: 2
    out: "contains: unrecognized arguments: --bogus"
