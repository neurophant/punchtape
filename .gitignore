# build artifact (repository root only)
/punchtape

# the one-command install distribution (make dist)
/dist/

# the punchtape instance service directories (generated state)
**/.punchtape/cache/
**/.punchtape/derived/
**/.punchtape/run.lock

# the demo build artifact (regenerated by demos/gouija/replay.sh)
demos/gouija/project/gouija-demo

# the rust demo build tree (regenerated by demos/rjq/replay.sh)
demos/rjq/project/target/

# the python demo's replay-built pinned environment
demos/enimda/.venv/

# Go test and coverage-instrumented build artifacts
*.test
*.out
*.gcno
*.gcda

# the repository-local python tooling venv (uv)
/.venv/

# python bytecode (campaign tools)
__pycache__/
*.pyc

# handoff working documents (never enter commits)
/handoffs/

# agent tool work areas (session-local)
.kilo/
.zcode/
.zcodeignore

# OS and editor noise
.DS_Store
*.swp
.idea/
.vscode/
