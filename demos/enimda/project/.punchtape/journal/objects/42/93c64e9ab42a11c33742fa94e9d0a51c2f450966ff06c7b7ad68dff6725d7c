intents:
- lines:
  - D1
  outcome: work
  prose: the version line holds
- lines:
  - D2
  outcome: work
  prose: the fixture borders hold
work: the standing library claimed whole; the version and the fixture borders
requirements:
- id: R1
  lines:
  - D1
  prose: the version line prints
- id: R2
  lines:
  - D2
  prose: the borders on the fixtures print
behaviors:
- id: lib/version
  name: the version line
  prose: the module reports its version
  claims:
  - enimda/__init__.py:1-12
  covers:
  - R1
  rows:
  - run: python3 -c "import enimda; print(enimda.__version__)"
    expect:
      rc: 0
      out: |
        2.1.0
- id: lib/scan
  name: the borders on the fixtures
  prose: three fixtures scanned fast, offsets pinned
  claims:
  - enimda/__init__.py:13-134
  covers:
  - R2
  rows:
  - run: python3 -c "from enimda import ENIMDA; print(ENIMDA(fp='tests/fixed/bordered.jpg').scan(fast=True))"
    expect:
      rc: 0
      out: |
        (4, 3, 3, 4)
  - run: python3 -c "from enimda import ENIMDA; print(ENIMDA(fp='tests/fixed/clear.jpg').scan(fast=True))"
    expect:
      rc: 0
      out: |
        (0, 0, 0, 0)
  - run: python3 -c "from enimda import ENIMDA; print(ENIMDA(fp='tests/fixed/outlined.jpg').scan(fast=True))"
    expect:
      rc: 0
      out: |
        (4, 2, 4, 4)
