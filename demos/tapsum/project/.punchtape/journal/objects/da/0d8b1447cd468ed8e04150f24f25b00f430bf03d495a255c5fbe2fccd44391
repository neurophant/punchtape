intents:
- lines:
  - D1
  outcome: work
  prose: the version line prints and holds
- lines:
  - D2
  outcome: work
  prose: the usage page prints and holds
work: first document of the backfill; the CLI's printed contract, pinned where bytes are exact
build: go build -o tapsum-demo ./cmd/tapsum
requirements:
- id: R1
  lines:
  - D1
  prose: the version line prints
- id: R2
  lines:
  - D2
  prose: the usage page prints
behaviors:
- id: cli/version
  name: the version line
  prose: version prints the exact line and exits zero
  claims:
  - cmd/tapsum/main.go:1-37
  covers:
  - R1
  rows:
  - run: ./tapsum-demo version
    expect:
      rc: 0
      out: |
        tapsum version 1.1.0
- id: cli/usage
  name: the usage page
  prose: help prints the whole usage page to stdout and exits zero
  claims:
  - cmd/tapsum/main.go:38-55
  covers:
  - R2
  rows:
  - run: ./tapsum-demo help
    expect:
      rc: 0
      out: "tapsum - tape-style checksums for files\n\nUsage:\n  tapsum <command> [arguments]\n\nCommands:\n  version        Print the version line and exit\n  help           Print this usage page and exit\n  watch <file>   Re-hash a file forever, one line per pass\n\nExamples:\n  tapsum version\n  tapsum watch server.log\n"
